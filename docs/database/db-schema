// Optional: paste into https://dbdiagram.io/d for a visual editor.
// Schema docs (Mermaid ERD): https://github.com/RedHatInsights/ros-ocp-backend/wiki/Database-Schema

Table rh_accounts {
  id bigint [increment]
  account text
  org_id text [not null]
  Indexes {
    id [pk]
    org_id [unique, type: btree]
  }
}

Table clusters {
  id bigint [increment]
  tenant_id bigint [ref: > rh_accounts.id]
  source_id text [not null]
  cluster_uuid text [not null]
  cluster_alias text [not null]
  last_reported_at datetime
  Indexes {
    id [pk]
    cluster_uuid [unique, type: btree]
    tenant_id [name: "rh_accounts.id_fkey", type: btree]
  }
}

Table workloads {
  id bigint [increment]
  org_id text [not null]
  cluster_id bigint [ref: > clusters.id]
  experiment_name text
  namespace text
  workload_type text
  workload_name text
  containers text[]
  metrics_upload_at datetime
  Indexes {
    id [pk]
    cluster_id [name: "clusters.id_fkey", type: btree]
    containers [type: gin] // gin index is not supported in dbdiagram.io so this will throw error
  }
}

Table workload_metrics {
  id bigint [increment]
  org_id text [not null]
  workload_id bigint [ref: > workloads.id]
  container_name text
  namespace_name text
  metric_type text // container | namespace
  interval_start datetime
  interval_end datetime
  usage_metrics jsonb
  Indexes {
    id [pk]
  }
}

Table recommendation_sets {
  id uuid [increment]
  workload_id bigint [ref: > workloads.id]
  container_name text
  monitoring_start_time datetime
  monitoring_end_time datetime
  recommendations jsonb
  cpu_request_current numeric
  memory_request_current numeric
  // plus 12 *_variation_*_pct sortable columns — see wiki / migrations 000023–000024
  updated_at datetime
  Indexes {
    id [pk]
    workload_id [name: "workloads.id_fkey", type: btree]
    (workload_id, container_name) [unique, type: btree]
  }
}

Table historical_recommendation_sets {
  id uuid [increment]
  org_id text [not null]
  workload_id bigint [ref: > workloads.id]
  container_name text
  monitoring_start_time datetime
  monitoring_end_time datetime
  recommendations jsonb
  updated_at datetime
  Indexes {
    id [pk]
    workload_id [name: "workloads.id_fkey", type: btree]
    (workload_id, container_name, monitoring_end_time) [unique, type: btree]
  }
}

Table namespace_recommendation_sets {
  id uuid [increment]
  org_id text [not null]
  workload_id bigint [ref: > workloads.id]
  namespace_name text
  monitoring_start_time datetime
  monitoring_end_time datetime
  recommendations jsonb
  cpu_request_current numeric
  memory_request_current numeric
  // plus 12 *_variation_*_pct sortable columns — see wiki / migrations 000020–000025
  updated_at datetime
  Indexes {
    id [pk]
    workload_id [unique, type: btree]
  }
}

Table historical_namespace_recommendation_sets {
  id bigint [increment]
  org_id text [not null]
  workload_id bigint [ref: > workloads.id]
  namespace_name text
  monitoring_start_time datetime
  monitoring_end_time datetime
  recommendations jsonb
  updated_at datetime
  Indexes {
    id [pk]
    (org_id, workload_id, monitoring_end_time) [unique, type: btree]
  }
}
